{
    "uid": "gather-it-http",
    "title": "gather.it / HTTP services",
    "description": "RED metrics for every HTTP service. Healthchecks excluded.",
    "tags": [
        "gather-it"
    ],
    "editable": true,
    "graphTooltip": 1,
    "schemaVersion": 41,
    "version": 1,
    "time": {
        "from": "now-6h",
        "to": "now"
    },
    "refresh": "1m",
    "templating": {
        "list": [
            {
                "name": "service",
                "label": "Service",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "prometheus"
                },
                "query": {
                    "query": "label_values({__name__=~\"http_server_request_duration_seconds_count|http_server_duration_milliseconds_count\", service_namespace=\"gather-it\"}, service_name)",
                    "refId": "service"
                },
                "definition": "label_values({__name__=~\"http_server_request_duration_seconds_count|http_server_duration_milliseconds_count\", service_namespace=\"gather-it\"}, service_name)",
                "multi": true,
                "includeAll": true,
                "current": {
                    "text": "All",
                    "value": "$__all"
                },
                "refresh": 2,
                "sort": 1
            }
        ]
    },
    "annotations": {
        "list": []
    },
    "links": [
        {
            "type": "dashboards",
            "tags": [
                "gather-it"
            ],
            "asDropdown": true,
            "title": "gather.it"
        }
    ],
    "panels": [
        {
            "type": "row",
            "title": "Overview",
            "collapsed": false,
            "panels": [],
            "id": 1,
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 24,
                "h": 1
            }
        },
        {
            "type": "timeseries",
            "title": "Request rate by service",
            "description": "",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_route!~\"api/health|/healthcheck\"}[$__rate_interval]))",
                    "legendFormat": "{{service_name}}",
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "prometheus"
                    },
                    "expr": "sum by (service_name) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\", http_target!~\"api/health|/healthcheck\"}[$__rate_interval]))",
                    "legendFormat": "{{service_name}}",
                    "refId": "B"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": {
                        "drawStyle": "line",
                        "fillOpacity": 10,
                        "lineWidth": 1,
                        "showPoints": "never",
                        "spanNulls": false,
                        "stacking": {
                            "mode": "none",
                            "group": "A"
                        }
                    },
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
